FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends v4l-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements.web.txt ./
RUN pip install --no-cache-dir -r requirements.web.txt
COPY calibration.py tag_edges.py floor_geometry.py floor_session.py robot_tracking.py app.py ./
COPY web ./web
ENV DATA_DIR=/data CAMERA_DEVICE=/dev/camera
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
